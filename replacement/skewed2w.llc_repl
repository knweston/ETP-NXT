/*
   Modified NRU for 2-way skewed cache, proposed by Andre Seznec
   - 1 RU bit per set
   - Hit/New Allocated:
      - ru_bit[set_id][0] = 1 when way 0 is accessed
      - ru_bit[set_id][0] = 0 when way 1 is accessed
   - Miss:
      - ru_bit[set_id][0] = 0: victimize way 0
      - ru_bit[set_id][0] = 1: victimize way 1
*/

#include "cache.h"

// initialize replacement state
void CACHE::llc_initialize_replacement() {
   assert(LLC_WAY == 2);
   for(int i=0; i<LLC_SET; i++) {
      for(int j=0; j<LLC_WAY; j++)
         ru_bit[i][j] = false;
   }
}

// find replacement victim
uint32_t CACHE::llc_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
   // type cast index ptr to skewed cache
   SkewedIndex* m_skewed_index = static_cast<SkewedIndex*>(m_index);

   // call get_victim from SkewedIndex class
   uint32_t set_id = 0;
   uint32_t way_id = 0;
   m_skewed_index->get_victim(full_addr>>LOG2_BLOCK_SIZE, &set_id, &way_id);

   if (block[set_id][way_id].valid && m_index) {
      m_index->increment_eviction(set_id);
   }
   return way_id;
}

// called on every cache hit and cache fill
void CACHE::llc_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit)
{
   // type cast index ptr to skewed cache
   SkewedIndex* m_skewed_index = static_cast<SkewedIndex*>(m_index);
   uint32_t way0_idx = m_skewed_index->compute_index(full_addr>>LOG2_BLOCK_SIZE, m_skewed_index->get_bitmask(0), m_skewed_index->get_bitmask(1));

   if (way == 0)
      ru_bit[way0_idx][0] = 1;
   else
      ru_bit[way0_idx][0] = 0;
}

void CACHE::llc_replacement_final_stats()
{
   // do nothing
}


void SkewedIndex::get_victim(uint64_t address, uint32_t* set_id, uint32_t* way_id) {
   uint32_t way0_idx = compute_index(address, m_shuffled_bit_sels[0], m_shuffled_bit_sels[1]);
   uint32_t way1_idx = compute_index(address, m_shuffled_bit_sels[0], m_shuffled_bit_sels[2]);

   // victimize invalid lines if any
   if (!block_array[way0_idx][0].valid) {
      *set_id = way0_idx;
      *way_id = 0;
      return;
   }
   else if (!block_array[way1_idx][1].valid) {
      *set_id = way1_idx;
      *way_id = 1;
      return;
   }

   if (ru_bit[way0_idx][0] == 0) {
      *set_id = way0_idx;
      *way_id = 0;
   }
   else {
      *set_id = way1_idx;
      *way_id = 1;
   }
}