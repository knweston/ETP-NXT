#include "cache.h"
#include <algorithm>

vector<uint64_t> dead_blocks;
string DBLK_FILE_PATH;
uint32_t num_dblk_found = 0;

bool is_dead_block(uint64_t x_addr) {
    bool found = binary_search(dead_blocks.begin(), dead_blocks.end(), x_addr);
    if (found) {
        num_dblk_found++;
    }
    return found;
}

// initialize replacement state
void CACHE::llc_initialize_replacement()
{
    // only works in single-core setup for now
    uint32_t appname_endpt;
    
    if(APP_PATH[0].find(".champsimtrace.xz") != -1){
        appname_endpt = APP_PATH[0].find(".champsimtrace.xz");
    }
    else{
        appname_endpt = APP_PATH[0].find(".champsimtrace.gz");
    }

    for (uint32_t i=0; i<appname_endpt; ++i) {
        DBLK_FILE_PATH += APP_PATH[0][i];
    }
    DBLK_FILE_PATH += "-DEAD-BLKS.txt";
    cout << "DBLK_FILE_PATH: " << DBLK_FILE_PATH << endl;

    ifstream dblk_file(DBLK_FILE_PATH);
    string line;
    uint64_t address;
    if (dblk_file.is_open()) {
        while(getline(dblk_file, line)) {
            stringstream ss(line);
            ss >> hex >> address;

            // skip zero address
            if (!address)
                continue;
            
            dead_blocks.push_back(address);
        }
        dblk_file.close();
        sort(dead_blocks.begin(), dead_blocks.end());
        cout << "Deadblocks list initialized." << endl;
    }
    else {
        cout << "Deadblocks File not found." << endl;
        exit(0);
    }

    if (LLC_INDEX_TYPE == 9) {
        EntropyIndex* entropy = dynamic_cast<EntropyIndex*>(m_index);
        EntropyV3* etp3 = dynamic_cast<EntropyV3*>(entropy);
        etp3->set_perfect_deadblk_mode(true, dead_blocks);
    }
}

// find replacement victim
uint32_t CACHE::llc_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // baseline LRU
    return lru_victim(cpu, instr_id, set, current_set, ip, full_addr, type); 
}

// called on every cache hit and cache fill
void CACHE::llc_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit)
{
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    // uncomment this line to see the LLC accesses
    // cout << "CPU: " << cpu << "  LLC " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    // cout << hex << " paddr: " << setw(12) << paddr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;

    // baseline LRU
    if (hit && (type == WRITEBACK)) // writeback hit does not update LRU state
        return;
    
    if (!hit && is_dead_block(full_addr>>LOG2_BLOCK_SIZE)) {
        // put it in the LRU position
        for (uint32_t i=0; i<NUM_WAY; i++) {
            if (block[set][i].lru > block[set][way].lru) {
                block[set][i].lru--;
            }
        }
        block[set][way].lru = NUM_WAY-1;
    }
    else {
        lru_update(set, way);
    }
    return;
}

void CACHE::llc_replacement_final_stats()
{
    cout << "Num deadblocks found: " << num_dblk_found << endl;
}

void SkewedIndex::get_victim(uint64_t address, uint32_t* set_id, uint32_t* way_id) {}